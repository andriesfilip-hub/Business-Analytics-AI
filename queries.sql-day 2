--------------------------------EXAMPLE 1 => Data Aggregation (COUNT, AVG, MAX + GROUP BY)

"Provide a regional summary showing the total count of customers, average credit score, and maximum estimated salary grouped by country."

SELECT Geography, 
       COUNT(CustomerId) AS Total_Clients, 
       AVG(CreditScore) AS Average_Credit_Score, 
       MAX(EstimatedSalary) AS Max_Salary
FROM Customers
GROUP BY Geography;

