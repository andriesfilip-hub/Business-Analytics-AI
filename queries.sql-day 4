------------------------------EXAMPLE 2 => Organizing Complex Queries using Common Table Expressions/CTE (WITH Clause)

"Calculate the average balance per country in a temporary table (CTE), then filter and display only those countries where the calculated average balance exceeds 70,000."

WITH Country_Avg_Balances AS (
    SELECT 
        Geography,
        ROUND(AVG(Balance), 2) AS Avg_Sold
    FROM Customers
    GROUP BY Geography
)
SELECT 
    Geography,
    Media_Sold
FROM Country_Avg_Balances
WHERE Avg_Sold > 70000;

