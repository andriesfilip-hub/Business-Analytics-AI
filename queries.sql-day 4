------------------------------EXAMPLE 3 => Filtering Window Functions using CTEs (Top N per Category)

"Find the top 2 highest-earning customers from each country (Geography) using a CTE and a window function (ROW_NUMBER())."

WITH Ranked_Salaries_By_Country AS (
    SELECT 
        Geography,
        Surname,
        EstimatedSalary,
        ROW_NUMBER() OVER (
            PARTITION BY Geography 
            ORDER BY EstimatedSalary DESC
        ) AS Country_Salary_Rank
    FROM Customers
)
SELECT 
    Geography,
    Surname,
    EstimatedSalary,
    Country_Salary_Rank
FROM Ranked_Salaries_By_Country
WHERE Country_Salary_Rank <= 2
ORDER BY Geography ASC, Country_Salary_Rank ASC;

