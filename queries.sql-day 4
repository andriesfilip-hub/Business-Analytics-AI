------------------------------EXAMPLE 4 => Analytical Aggregations with Window Functions (LAG and LEAD)

"Display a list of customers ordered by their estimated salary, showing each customer's surname, estimated salary, 
and the salary of the customer directly preceding them in the ranking (Previous_Salary)."

SELECT 
    Surname,
    EstimatedSalary,
    LAG(EstimatedSalary) OVER (ORDER BY EstimatedSalary DESC) AS Previous_Salary
FROM Customers
ORDER BY EstimatedSalary DESC;

--EXERCISE 1

SELECT
	Geography,
	Surname,
	CreditScore,
	LEAD(CreditScore) OVER (ORDER BY CreditScore DESC) AS Next_Credit_Score
FROM Customers
WHERE Geography = 'Germany'
ORDER BY CreditScore DESC;

--EXERCISE 2

WITH Salary_Differences AS (
	SELECT
		Surname,
		EstimatedSalary,
		LAG(EstimatedSalary) OVER (ORDER BY EstimatedSalary DESC) AS Previous_Salary
		FROM Customers
		WHERE Gender = 'Male'
)
SELECT
	Surname,
	EstimatedSalary,
	Previous_Salary,
	(EstimatedSalary - Previous_Salary) AS Salary_Gap
FROM Salary_Differences
ORDER BY EstimatedSalary DESC;









