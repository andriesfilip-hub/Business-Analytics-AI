----------------------------EXAMPLE 7 => Global Rankings (Window Functions - ROW_NUMBER)

"Generate a ranked list of all customers in France based on their estimated salary, assigning rank 1 to the highest earner using a window function."

SELECT 
    Surname,
    EstimatedSalary,
    ROW_NUMBER() OVER (ORDER BY EstimatedSalary DESC) AS Top_In_Place
FROM Customers
WHERE Geography = 'France'
ORDER BY Top_In_Place ASC;

