----------------------------EXAMPLE 5 => Pre-filtering with Aggregation (WHERE + GROUP BY)

"Calculate the average estimated salary rounded to 2 decimal places, exclusively for credit card holders (HasCrCard = 1), grouped by country and sorted by highest average salary."

SELECT 
    Geography,
    ROUND(AVG(EstimatedSalary), 2) AS AVG_Salary_With_Card
FROM Customers
WHERE HasCrCard = 1
GROUP BY Geography
ORDER BY AVG_Salary_With_Card DESC;

