----------------------------EXAMPLE 6 => Custom Segmentation & Aggregation

"Segment French customers (Geography = 'France') into balance tiers ('Fara Bani' / 'Zero Balance' if balance is 0, otherwise 'Cu Bani' / 'With Balance') and calculate their average age rounded to 1 decimal place."

SELECT 
    CASE 
        WHEN Balance = 0 THEN 'No Balance' 
        ELSE 'With Balance' 
    END AS Balance_Category,
    ROUND(AVG(Age), 1) AS AVG_Age
FROM Customers
WHERE Geography = 'France'
GROUP BY Balance_Category
ORDER BY AVG_Age DESC;

--EXERCISE 1

