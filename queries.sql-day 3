----------------------------EXAMPLE 8 => Partitioned Rankings (PARTITION BY)

"Rank all customers within their respective countries based on their account balance, resetting the rank back to 1 for each new country (PARTITION BY Geography)."

SELECT 
    Geography,
    Surname,
    Balance,
    ROW_NUMBER() OVER (
        PARTITION BY Geography 
        ORDER BY Balance DESC
    ) AS Top_Place_In_Country
FROM Customers
ORDER BY Geography ASC, Top_Place_In_Country ASC;

--EXERCISE 1

SELECT
	Gender,
	Surname,
	CreditScore,
	ROW_NUMBER() OVER (
		PARTITION BY Gender
		ORDER BY CreditScore DESC
	) AS Top_Place_for_CrScore_In_Country
FROM Customers
ORDER BY Gender ASC, Top_Place_for_CrScore_In_Country ASC;

